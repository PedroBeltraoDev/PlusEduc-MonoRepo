# Copie para .env (nunca commite o .env)

# Desenvolvimento: destino do proxy Vite (/api -> backend)
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Produção (build): URL base da API, se o frontend estiver em outro domínio
# Deixe comentado para usar /api no mesmo host (reverse proxy)
# VITE_API_BASE_URL=https://sua-api.exemplo.com/api
