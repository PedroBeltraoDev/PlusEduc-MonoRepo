# Ambiente da aplicação
APP_NAME=PlusEduc API
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# MongoDB local
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=escola_db
MONGODB_REQUIRED=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
MONGODB_CONNECT_TIMEOUT_MS=2000

# CORS — informe as origens reais do frontend separadas por vírgula quando necessário
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# JWT — substitua o placeholder por um segredo forte e exclusivo
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION_MS=28800000
JWT_REFRESH_EXPIRATION_MS=604800000

# Gemini — preencha GEMINI_API_KEY somente no .env local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_VERSION=v1

# E-mail (recuperação de senha) — preencha somente no .env local
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PlusEduc

# Em ambiente de demonstração, as contas de professor/aluno não são caixas de
# e-mail reais. Quando preenchido, todo código de recuperação de senha é
# enviado para este endereço, independente do e-mail da conta solicitante.
PASSWORD_RESET_OVERRIDE_EMAIL=
PASSWORD_RESET_CODE_TTL_MINUTES=15
