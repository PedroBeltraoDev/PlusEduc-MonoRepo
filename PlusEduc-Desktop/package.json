{
  "name": "pluseduc-desktop",
  "productName": "PlusEduc",
  "version": "1.0.0",
  "description": "PlusEduc - Soluções Inteligentes para a Educação (aplicativo de desktop)",
  "author": "PlusEduc",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.com.pluseduc.desktop",
    "productName": "PlusEduc",
    "copyright": "PlusEduc",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "loading.html",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "resources/PlusEduc-API",
        "to": "PlusEduc-API"
      },
      {
        "from": "../PlusEduc-UI/dist",
        "to": "ui"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlusEduc",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "PlusEduc-Setup-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
